# ------------------------------------------------------------------
# Modèle de .env pour la mise en ligne (alwaysdata).
# Sur le serveur : copier ce fichier en .env puis remplacer chaque VOTRE-COMPTE,
# et chaque valeur entre < >. Ne jamais envoyer le .env rempli sur GitHub.
# ------------------------------------------------------------------

APP_NAME="FRANCK ARNAULT"
APP_ENV=production
APP_KEY=
# Laisser à false en ligne : à true, les pages d'erreur affichent vos mots de passe.
APP_DEBUG=false
APP_URL=https://VOTRE-COMPTE.alwaysdata.net
# Fuseau horaire des publications programmées (ex. Europe/Paris, Africa/Kinshasa, Africa/Abidjan).
APP_TIMEZONE=UTC

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

# Base créée dans alwaysdata : Bases de données > MySQL
DB_CONNECTION=mysql
DB_HOST=mysql-VOTRE-COMPTE.alwaysdata.net
DB_PORT=3306
DB_DATABASE=VOTRE-COMPTE_franck
DB_USERNAME=<utilisateur de la base>
DB_PASSWORD=<mot de passe de la base>

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Vidéos envoyées sur le site (menu Vidéos). 50 Mo par vidéo avec l'hébergement gratuit (100 Mo en tout) :
# à augmenter chez un hébergeur plus grand (ex. 300). Les vidéos YouTube ne sont pas concernées.
VIDEO_MAX_MB=50

# E-mails (réinitialisation du mot de passe admin) : écrits dans storage/logs tant qu'aucun SMTP n'est configuré.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="contact@exemple.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Compte administrateur créé par : bash scripts/deploy.sh --premiere-installation
# ⚠ Videz ADMIN_PASSWORD juste après.
ADMIN_NAME=Administrateur
ADMIN_EMAIL=<votre e-mail>
ADMIN_PASSWORD=<mot de passe de 12 caractères minimum>
